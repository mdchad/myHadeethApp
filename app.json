{
  "expo": {
    "scheme": "myway",
    "owner": "pixelmind",
    "orientation": "portrait",
    "icon": "./assets/icon-2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-3.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2A4F"
    },
    "version": "1.0.10",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "name": "My Way",
    "slug": "myWay",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "06765aee-13df-4192-8675-90bab00f9e6c"
      }
    },
    "plugins": [
      "@config-plugins/react-native-blob-util",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow My Way to use your location."
        }
      ],
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/kfgqpc-arabic-symbols.ttf",
            "./assets/fonts/KFGQPC-Regular.ttf",
            "./assets/fonts/KFGQPC-Bold.ttf",
            "./assets/fonts/uthmanic-hafs.ttf",
            "node_modules/@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
            "node_modules/@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf",
            "node_modules/@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "myway-app",
          "organization": "pixelmind-studio"
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "bundleIdentifier": "com.mdchad.myWay",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationAlwaysUsageDescription": "Location access is required to determine the Qibla direction from your current position",
        "NSLocationWhenInUseUsageDescription": "Location access is required to determine the Qibla direction from your current position",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mdchad.myWay",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
  }
}
